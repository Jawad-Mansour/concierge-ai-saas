# ================================================================
# Concierge — Bootstrap environment file
# ================================================================
# IMPORTANT: Real secrets live in Vault. This file exists only to
# bootstrap the stack itself (Vault, Postgres, MinIO) and to forward
# placeholder API keys into vault-init on first startup.
# Never commit real credentials here.
# Copy to .env and fill in real values before running the stack.
# ================================================================

# ── Vault ────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token
VAULT_KV_PATH_PREFIX=secret/concierge

# ── Port Mappings ─────────────────────────────────────────────
API_PORT=8000
MODELSERVER_PORT=8001
GUARDRAILS_PORT=8002
ADMIN_PORT=8501
WIDGET_PORT=8081
DEMO_HOST_PORT=8080
DEMO_BLOCKED_PORT=8090
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200
LANGFUSE_PORT=3001

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=concierge
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/concierge

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000

# ── Langfuse (tracing) ────────────────────────────────────────
# Uses the default 'postgres' database. In production, provision a
# dedicated database and update LANGFUSE_DATABASE_URL accordingly.
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
LANGFUSE_NEXTAUTH_SECRET=dev-nextauth-secret-change-in-prod
LANGFUSE_SALT=dev-salt-change-in-prod
# Generate real keys from your Langfuse instance or app.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_HOST=http://langfuse:3001

# ── LLM API key ─────────────────────────────────────────────────────
# Real key required — get it from Charbel.
# This value is forwarded to vault-init and written to
# secret/concierge/anthropic in Vault. Services read from Vault,
# never from this file directly.
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-REAL-KEY
EMBEDDINGS_API_KEY=replace-me
EMBEDDINGS_MODEL=text-embedding-3-small
