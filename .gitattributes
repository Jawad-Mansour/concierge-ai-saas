# Owner: Shared

# Default: let git auto-detect and normalize to LF in the repo
* text=auto eol=lf

# Shell scripts MUST be LF — they run inside Linux containers
*.sh text eol=lf
*.bash text eol=lf

# Dockerfile + compose
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Config files that get parsed by Linux tools
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.sql text eol=lf
.env* text eol=lf

# Python — LF for cross-platform consistency
*.py text eol=lf

# Frontend
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows batch files genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.joblib binary
*.zip binary
*.tar.gz binary